{
  "name": "dispatches-1941",
  "version": "1.0.0",
  "description": "Dispatches 1941: the Pacific war from IGHQ and CINCPAC. Source reconstructed from the shipped single-file build.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify:baseline": "node ../packages/testkit/src/cli.mjs verify",
    "split": "node ../packages/testkit/src/split.mjs split",
    "assemble": "node ../packages/testkit/src/split.mjs assemble",
    "roundtrip": "node ../packages/testkit/src/split.mjs roundtrip",
    "check:structure": "node tools/check-structure.mjs",
    "test:fast": "npm run build && npm run typecheck && npm run test:logic && npm run test:json && npm run check:structure && npm run roundtrip && npm run verify:baseline && npm run test:migration && npm run test:saves && npm run check:orphans && npm run check-quotations && npm run check-writing && npm run check-reachability && npm run check-advisor-dates && npm run check-outcome-sign && npm run check-endings && npm run check-rolls && npm run check-map",
    "release": "node ../packages/testkit/src/release.mjs",
    "test:saves": "node ../packages/testkit/src/cli.mjs saves-verify",
    "baseline:accept": "node ../packages/testkit/src/cli.mjs accept",
    "check-reachability": "node tools/check-reachability.mjs",
    "check-advisor-dates": "node tools/check-advisor-dates.mjs",
    "check-outcome-sign": "node tools/check-outcome-sign.mjs",
    "check-endings": "node tools/check-endings.mjs",
    "test:logic": "node tests/logic-rules.test.mjs",
    "check-map": "node tools/check-map.mjs",
    "audit": "npm run check:orphans && npm run check-reachability && npm run check-advisor-dates && npm run check-outcome-sign && npm run check-endings && npm run check-rolls && npm run check-map && npm run check-quotations && npm run check-writing",
    "check-quotations": "node tools/check-quotations.cjs",
    "check-writing": "node ../tools/check-writing.mjs . --strict",
    "check:orphans": "node tools/check-orphans.mjs",
    "test:migration": "node tests/migration.test.mjs",
    "test:json": "node tests/json-nodes.test.mjs",
    "extract:json": "node tools/extract-json-nodes.mjs",
    "check-rolls": "node tools/check-rolls.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "jsdom": "^30.1.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tone": "^15.1.22"
  },
  "release": {
    "build": "npm run build",
    "variants": [
      {
        "name": "full",
        "from": "dist/full",
        "zip": "dispatches-1941-full.zip"
      },
      {
        "name": "demo",
        "from": "dist/demo",
        "zip": "dispatches-1941-demo.zip"
      }
    ]
  }
}
