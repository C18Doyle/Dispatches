{
  "name": "sherlock-final-problem",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p ../packages/engine/tsconfig.json",
    "validate": "tsx scripts/validate.ts",
    "validate:schema": "tsx ../packages/engine/tools/validate_schema.ts sherlock",
    "verify:baseline": "tsx ../packages/engine/tools/verify_baseline.ts sherlock",
    "check:boundaries": "node ../packages/engine/tools/check_boundaries.mjs",
    "test": "npm run typecheck && npm run check:boundaries && npm run check:gen && npm run validate:schema && npm run check:prose && npm run check:claims && npm run check:map && npm run check:calendar && npm run verify:baseline && npm run validate && npm run check:balance && npm run test:saves && npm run test:ledger && npm run verify:ui && npm run check:demo && npm run check-a11y",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/styles.css --minify",
    "build:js": "node esbuild.config.mjs",
    "build": "npm run build:css && npm run build:js && node scripts/fonts.mjs && node scripts/inline.mjs && npm run build:demo",
    "test:fast": "npm test",
    "release": "node ../packages/testkit/src/release.mjs",
    "test:saves": "tsx scripts/test_saves.ts",
    "verify:ui": "npm run build && node ../packages/testkit/src/cli.mjs verify",
    "ui:accept": "node ../packages/testkit/src/cli.mjs accept",
    "check-a11y": "node scripts/check-a11y.mjs",
    "record:baseline": "tsx ../packages/engine/tools/record_baseline.ts sherlock",
    "check:balance": "tsx scripts/balance_check.ts",
    "test:ledger": "tsx scripts/test_ledger.ts",
    "check:claims": "node scripts/check_canon_claims.mjs",
    "check:map": "tsx scripts/check_map.ts",
    "check:calendar": "tsx scripts/check_calendar.ts",
    "gen": "node gen/build.mjs",
    "check:gen": "node gen/build.mjs --check",
    "check:prose": "node scripts/check_prose.mjs",
    "build:demo": "node esbuild.config.mjs --demo && node scripts/inline.mjs --demo",
    "check:demo": "node scripts/check_demo.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rokkitt": "^5.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "release": {
    "build": "npm run build",
    "variants": [
      {
        "name": "full",
        "from": "dist",
        "zip": "dispatches-sherlock-full.zip",
        "include": [
          "index.html",
          "README.txt"
        ]
      },
      {
        "name": "demo",
        "from": "dist/demo",
        "zip": "dispatches-sherlock-demo.zip",
        "include": [
          "index.html"
        ]
      }
    ]
  }
}
