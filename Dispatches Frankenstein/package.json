{
  "name": "frankenstein-jam",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p ../packages/engine/tsconfig.json",
    "validate": "tsx scripts/validate.ts",
    "validate:schema": "tsx ../packages/engine/tools/validate_schema.ts frankenstein",
    "verify:baseline": "tsx ../packages/engine/tools/verify_baseline.ts frankenstein",
    "check:boundaries": "node ../packages/engine/tools/check_boundaries.mjs",
    "test": "npm run typecheck && npm run check:boundaries && npm run validate:schema && npm run verify:baseline && npm run validate && npm run test:saves",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/styles.css --minify",
    "build:js": "node esbuild.config.mjs",
    "build:audio": "node scripts/copy_audio.mjs",
    "build": "npm run build:css && npm run build:js && npm run build:audio && node scripts/inline.mjs",
    "test:fast": "npm test",
    "release": "node ../packages/testkit/src/release.mjs",
    "test:saves": "tsx scripts/test_saves.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "release": {
    "build": "npm run build",
    "variants": [
      {
        "name": "web",
        "from": "dist",
        "zip": "dispatches-frankenstein-web.zip",
        "include": [
          "index.html",
          "audio"
        ]
      }
    ]
  }
}
