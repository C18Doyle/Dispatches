  "account": {
    "heading": "What It Cost",
    "intro": "The people named in this passage, and what became of them. The list is plain on purpose.",
    "people": [
      {
        "name": "Jonathan Harker",
        "lines": [
          {
            "when": {
              "flag": "harkerDead"
            },
            "text": "He did not go home."
          },
          {
            "when": {
              "flag": "harkerFree"
            },
            "text": "You left his door open, and he walked out."
          },
          {
            "when": {
              "flag": "harkerLocked"
            },
            "text": "You left him locked in with the key to be found. He found it."
          }
        ]
      },
      {
        "name": "The three in the east wing",
        "lines": [
          {
            "when": {
              "flag": "sistersPromised"
            },
            "text": "You owe them a man, and they have kept count."
          },
          {
            "when": {
              "flag": "sistersFed"
            },
            "text": "You took them to the hill pastures, and the shepherds spoke of wolves."
          },
          {
            "when": {
              "flag": "sistersForbidden"
            },
            "text": "You drove them back from him, and they have not forgotten it."
          }
        ]
      },
      {
        "name": "The crew of the Demeter",
        "lines": [
          {
            "when": {
              "flag": "crewTaken"
            },
            "text": "You took them one at a time. The master was found lashed to the wheel."
          },
          {
            "when": {
              "flag": "crewSpared"
            },
            "text": "You left them alone, and they did not forget the hold."
          }
        ]
      },
      {
        "name": "Mr Swales",
        "lines": [
          {
            "when": {
              "flag": "swalesDead"
            },
            "text": "He was found on his seat with his neck broken."
          },
          {
            "when": {
              "flag": "swalesTalked"
            },
            "text": "He told what he had seen, and nobody believed him."
          }
        ]
      },
      {
        "name": "Lucy Westenra",
        "lines": [
          {
            "when": {
              "flag": "lucyAtWindow"
            },
            "text": "A wolf came through her window, and her mother died in the room."
          },
          {
            "when": {
              "any": [
                {
                  "flag": "lucyTaken"
                },
                {
                  "flag": "lucyTakenFast"
                }
              ]
            },
            "text": "You took her blood through the autumn, and her doctors could not say why she failed."
          },
          {
            "when": {
              "flag": "lucyCourted"
            },
            "text": "You courted her, and she asked after you in her sleep."
          },
          {
            "when": {
              "flag": "mistVisit"
            },
            "text": "You came to her as a mist, and she smiled in her sleep."
          },
          {
            "when": {
              "flag": "lucyOnce"
            },
            "text": "You took a little, once, and she thought she had been ill."
          },
          {
            "when": {
              "flag": "lucyMarked"
            },
            "text": "You marked her at Whitby, and went on."
          },
          {
            "when": {
              "any": [
                {
                  "flag": "lucySpared"
                },
                {
                  "flag": "lucyLeftAlone"
                },
                {
                  "flag": "lucyAbandoned"
                }
              ]
            },
            "text": "You left her alone, and she mended."
          }
        ]
      },
      {
        "name": "Mrs Westenra",
        "lines": [
          {
            "when": {
              "any": [
                {
                  "flag": "lucyAtWindow"
                },
                {
                  "flag": "wolfSent"
                }
              ]
            },
            "text": "She died of the shock when the wolf came through the window."
          },
          {
            "when": {
              "flag": "flowersRemoved"
            },
            "text": "She took down the garlic with her own hands, at your word."
          }
        ]
      },
      {
        "name": "Mina Harker",
        "lines": [
          {
            "when": {
              "flag": "minaMarked"
            },
            "text": "You marked her, and she carries it."
          },
          {
            "when": {
              "flag": "minaListened"
            },
            "text": "You told her what you were. She said she would think."
          },
          {
            "when": {
              "flag": "minaSpoken"
            },
            "text": "You spoke to her, and she did not scream."
          },
          {
            "when": {
              "flag": "minaScreamed"
            },
            "text": "She screamed on purpose, and the house woke."
          },
          {
            "when": {
              "flag": "papersTaken"
            },
            "text": "You took her typescript, and she began it again."
          },
          {
            "when": {
              "flag": "minaRead"
            },
            "text": "You read what she had typed."
          },
          {
            "when": {
              "flag": "minaSpared"
            },
            "text": "You left her alone."
          }
        ]
      },
      {
        "name": "Renfield",
        "lines": [
          {
            "when": {
              "flag": "renfieldRescued"
            },
            "text": "You took him out of the asylum. He asked for a bird."
          },
          {
            "when": {
              "flag": "renfieldSteward"
            },
            "text": "You made him your steward, and he kept faith."
          },
          {
            "when": {
              "flag": "renfieldBound"
            },
            "text": "You promised him lives, and he watched your road."
          },
          {
            "when": {
              "flag": "renfieldUsed"
            },
            "text": "You used him once, to open a door."
          },
          {
            "when": {
              "any": [
                {
                  "flag": "renfieldRefused"
                },
                {
                  "flag": "renfieldSnubbed"
                }
              ]
            },
            "text": "You told him nobody was coming, and he stopped waiting."
          }
        ]
      },
      {
        "name": "The watcher in the crypt",
        "lines": [
          {
            "when": {
              "flag": "staredDown"
            },
            "text": "You held his eyes until the cross shook."
          },
          {
            "when": {
              "flag": "ratsAtCarfax"
            },
            "text": "You put out his lantern with rats."
          },
          {
            "when": {
              "flag": "mistedOut"
            },
            "text": "You gave him an empty crypt."
          }
        ]
      }
    ]
  },
