{
  "name": "dispatches-1914",
  "version": "1.0.0",
  "description": "Dispatches 1914: the Great War from OHL, GQG and STAVKA.",
  "scripts": {
    "build": "node build.mjs",
    "validate": "bash validate.sh",
    "smoke": "node smoke.js",
    "render": "node render-test.js",
    "roundtrip": "node roundtrip-test.mjs",
    "verify:baseline": "node ../packages/testkit/src/cli.mjs verify",
    "test": "npm run build && npm run smoke && npm run render && npm run roundtrip && npm run verify:baseline && npm run test:migration && npm run test:saves",
    "test:fast": "npm test && npm run check:orphans",
    "release": "node ../packages/testkit/src/release.mjs",
    "baseline:accept": "node ../packages/testkit/src/cli.mjs accept",
    "check:orphans": "node tools/check-orphans.mjs",
    "test:saves": "node ../packages/testkit/src/cli.mjs saves-verify",
    "test:migration": "node tests/migration.test.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "release": {
    "build": "npm run build",
    "variants": [
      {
        "name": "web",
        "from": "dist",
        "zip": "dispatches-1914-web.zip",
        "include": [
          "index.html"
        ]
      }
    ]
  }
}
