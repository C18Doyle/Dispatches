{
  "name": "dispatches-1914",
  "version": "1.4.3",
  "description": "Dispatches 1914: the Great War from OHL, GQG and STAVKA.",
  "scripts": {
    "build": "node build.mjs",
    "rig": "node build.mjs && node ../tools/serve-dist.mjs dist/rig 8768",
    "validate": "bash validate.sh",
    "smoke": "node smoke.js",
    "render": "node render-test.js",
    "roundtrip": "node roundtrip-test.mjs",
    "verify:baseline": "node ../packages/testkit/src/cli.mjs verify",
    "test": "npm run build && npm run test:demo && npm run test:rig && npm run smoke && npm run render && npm run roundtrip && npm run validate && npm run verify:baseline && npm run test:migration && npm run test:saves && npm run test:easy && npm run test:battle && npm run test:dynamic && npm run test:flow && npm run test:staff && npm run test:map && npm run test:ground",
    "test:fast": "npm test && npm run check:orphans",
    "release": "node ../packages/testkit/src/release.mjs",
    "baseline:accept": "node ../packages/testkit/src/cli.mjs accept",
    "check:orphans": "node tools/check-orphans.mjs",
    "test:saves": "node ../packages/testkit/src/cli.mjs saves-verify",
    "test:migration": "node tests/migration.test.mjs",
    "test:easy": "node tests/easy-mode.test.mjs",
    "test:battle": "node tests/battle.test.mjs",
    "test:dynamic": "node tests/dynamic.test.mjs",
    "test:flow": "node tests/flow.test.mjs",
    "test:staff": "node tests/staff.test.mjs",
    "test:map": "node tests/map.test.mjs",
    "test:ground": "node tests/ground.test.mjs",
    "test:demo": "node tests/demo.test.mjs",
    "test:rig": "node tests/rig.test.mjs",
    "audit:screens": "node tools/audit-screens.mjs",
    "playthrough": "node tools/playthrough.mjs",
    "review:build": "node tools/claims-review.mjs",
    "review:status": "node tools/claims-review.mjs --status",
    "review:apply": "node tools/apply-review.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "private": true,
  "release": {
    "build": "npm run build",
    "variants": [
      {
        "name": "full",
        "from": "dist/full",
        "zip": "dispatches-1914-full.zip",
        "include": [
          "index.html"
        ]
      },
      {
        "name": "demo",
        "from": "dist/demo",
        "zip": "dispatches-1914-demo.zip",
        "include": [
          "index.html"
        ]
      }
    ]
  }
}
